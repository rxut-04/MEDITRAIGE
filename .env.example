# --- OPENROUTER CLINICAL CHAT (server-only — never prefix with VITE_) ---
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_api_key
# Optional model override (default: openai/gpt-4o-mini)
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=MediTriage

# --- BEYOND PRESENCE (server-only — never prefix API key with VITE_) ---
# Dashboard API key: https://bey.dev
BEYOND_PRESENCE_API_KEY=your_beyond_presence_api_key

# Avatar UUID from Beyond Presence dashboard (NOT a managed bey.chat agent ID)
BEYOND_PRESENCE_AVATAR_ID=your_avatar_uuid_here

# Optional shared secret for POST /api/bey/create-advisory-call
# If set, client must send the same value as VITE_BEY_CALL_SECRET
BEY_CALL_SECRET=
VITE_BEY_CALL_SECRET=

# API server port (Vite proxies /api → this)
API_PORT=3001

# Phase 1 audit logs are written to data/audit/triage-audit.jsonl (gitignored)

# --- SUPABASE (Phase 2: auth + cloud chat history) ---
# Anon key is public by design; row-level security protects the data.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# --- PHASE 3 (clinic API + white-label) ---
# Service role is SERVER-ONLY — never prefix with VITE_
SUPABASE_SERVICE_ROLE_KEY=
# Dev API keys: mt_live_xxx:org-slug,mt_live_yyy:other-slug
TRIAGE_API_KEYS=mt_live_devkey123:demo-clinic
