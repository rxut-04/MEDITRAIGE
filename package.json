{
  "name": "meditriage-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"npm run dev:api\" \"npm run dev:web\"",
    "dev:web": "vite --port 3000 --host 0.0.0.0",
    "dev:api": "node server/index.js",
    "build": "vite build",
    "preview": "vite preview",
    "eval:triage": "node server/triage/eval/run.js",
    "lint": "eslint . --ext js,jsx --report-unused-disable-directives --max-warnings 0"
  },
